{
  "name": "quintet-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": { "quintet-mcp": "src/index.ts" },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:sidecar": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile ../src-tauri/binaries/quintet-mcp-aarch64-apple-darwin",
    "build:sidecar:linux": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile ../src-tauri/binaries/quintet-mcp-x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
