{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quintet.local/agent.schema.json",
  "title": "Quintet agent.md frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "icon", "color", "mission", "model", "outputs_dir", "board"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Folder name, kebab-case, unique." },
    "name": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "minLength": 1, "description": "SF Symbol name." },
    "color": { "type": "string", "enum": ["red", "orange", "yellow", "green", "mint", "teal", "cyan", "blue", "indigo", "purple", "pink", "brown", "gray"] },
    "version": { "type": "integer", "minimum": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "owns": { "type": "array", "items": { "type": "string" } },
    "does_not_own": { "type": "array", "items": { "type": "string" } },
    "model": { "type": "string", "enum": ["opus", "sonnet", "haiku"] },
    "max_turns": { "type": "integer", "minimum": 1, "maximum": 500 },
    "integrity": { "oneOf": [{ "type": "boolean" }, { "const": "when_graded" }] },
    "allowed_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "mcp_extra": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "state_snapshot": { "type": ["string", "null"] },
    "intake": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string", "enum": ["text", "single", "multi", "date", "file", "integrity"] },
          "prompt": { "type": "string" },
          "required": { "type": "boolean" },
          "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "default": {},
          "skip_if": { "type": "string", "minLength": 1 },
          "max": { "type": "integer", "minimum": 0, "maximum": 3 },
          "from_chat": { "type": "boolean" }
        }
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cron", "task"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "cron": { "type": "string", "minLength": 9 },
          "tz": { "type": "string" },
          "task": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "enum": ["opus", "sonnet", "haiku"] },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "outputs_dir": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "board": { "type": "string", "minLength": 1 }
  }
}
