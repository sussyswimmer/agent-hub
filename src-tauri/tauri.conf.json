{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimoire",
  "version": "1.0.1",
  "identifier": "studio.grimoire.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run icons && bun run dev",
    "beforeBuildCommand": "bun run icons && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grimoire",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#14131A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../seeds/": "seeds/" },
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
