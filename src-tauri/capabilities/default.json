{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core IPC, notifications for seals, revealing the bindings folder, and choosing a familiar's folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    "dialog:allow-open",
    { "identifier": "opener:allow-reveal-item-in-dir", "allow": [{ "path": "$HOME/.grimoire/**" }] }
  ]
}
